{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|Edit|Delete|Shell",
        "command": "python3 scripts/agent-hooks/protect_checks.py cursor"
      }
    ],
    "stop": [
      {
        "command": "python3 scripts/agent-hooks/require_check.py cursor",
        "loop_limit": 5,
        "timeout": 900
      }
    ]
  }
}
