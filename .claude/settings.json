{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/protect_checks.py\" claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 900,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/require_check.py\" claude"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 campaign-os/scripts/plan_action.py:*)",
      "Bash(python3 campaign-os\\scripts\\plan_action.py:*)",
      "Bash(python3 campaign-os/scripts/lodge_post.py:*)",
      "Bash(python3 campaign-os\\scripts\\lodge_post.py:*)",
      "Bash(python campaign-os/scripts/plan_action.py:*)",
      "Bash(python campaign-os\\scripts\\plan_action.py:*)",
      "Bash(python campaign-os/scripts/lodge_post.py:*)",
      "Bash(python campaign-os\\scripts\\lodge_post.py:*)",
      "Bash(py campaign-os/scripts/plan_action.py:*)",
      "Bash(py campaign-os\\scripts\\plan_action.py:*)",
      "Bash(py campaign-os/scripts/lodge_post.py:*)",
      "Bash(py campaign-os\\scripts\\lodge_post.py:*)",
      "PowerShell(python campaign-os\\scripts\\plan_action.py:*)",
      "PowerShell(python campaign-os\\scripts\\lodge_post.py:*)"
    ]
  }
}
