{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "languages": {
        "python": {
          "version": "3.12"
        }
      },
      "startCommand": "cd campaign-os && python app.py"
    },
    "_redeploy_trigger": "c0c5f3a-tier3.17-final-cache-bust"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30,
    "env": {
      "PORT": "8000",
      "DATA_DIR": "/data/campaign-os"
    },
    "volumes": [
      {
        "mountPath": "/data/campaign-os"
      }
    ]
  }
}