credentials.json
tiktok-marketing/config.json
*.log
node_modules/
.DS_Store
__pycache__/
*.pyc
.venv/

# Local secrets (Step 73). The canonical credential directory lives outside
# this repository (clients/swing-shack/credentials/) so it does not need
# to be ignored here. These patterns catch accidental in-repo copies.
*.local.json
.env
.env.*

# Block the in-repo `credentials/` directory entirely. It pre-dates this
# line (8 legacy service-account files cloned here by a prior process),
# but it MUST NOT be committed. Live credentials belong in the canonical
# directory outside the repo. If this line is removed, the next
# `git add .` would leak tokens. Hardened 2026-08-06 when the Ubersuggest
# MCP OAuth flow landed.
credentials/
credentials/**

# Brand directory: keep dissector outputs but exclude raw image files
# (they live in Google Drive as source of truth)
data/brand-directory/*/images/*.jpg
data/brand-directory/*/images/*.jpeg
data/brand-directory/*/images/*.png
data/freshness-detail.json

# Nightshift scratch dir (probes, screenshots, ad-hoc test scripts).
# Created 2026-08-17 to stop the working-tree churning on every tick.
.scratchpad/
