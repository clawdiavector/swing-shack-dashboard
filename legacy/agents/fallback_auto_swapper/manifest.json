{
  "schema": "https://clawdia.io/agents/manifest/v1",
  "agent_id": "fallback_auto_swapper",
  "layer": 7,
  "role": "Auto-swaps blocked content with safe fallbacks — LIMITED autonomy only",
  "criticality": "HIGH",
  "owner": "clawdia",
  "scripts": ["run_fallback_auto_swapper.js"],
  "inputs": {
    "data/autonomy-rules.json": "Rules",
    "data/schedule-board.json": "Blocked slots",
    "data/fallback-queue.json": "Available fallbacks"
  },
  "outputs": {
    "data/auto-swaps.json": "Swap log"
  }
}