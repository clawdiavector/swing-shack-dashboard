  "notes": {
    "how_brands_partition": "Every campaign, asset, hook, meme, caption, GBP post, FAQ, scheduled item and published item carries a brand_id field (or inherits it from its campaign). When a brand is selected in the UI, every endpoint filters its data by brand_id. The schedule and review queue are brand-scoped. The calendar shows only the selected brand by default, with an 'all brands' option.",
    "onboarding_new_brand": [
      "1. Add a new brand block to brands.json with a unique id.",
      "2. Add the matching voice entry to voice_bible.json#voices/<brand-id> with the same label.",
      "3. Run the bootstrap flow (POST /api/brands/<brand-id>/bootstrap) to scaffold campaign-data.json with brand partition.",
      "4. The brand appears in the picker immediately."
    ],
    "asset_partition_rules": [
      "campaigns[].brand_id = the brand that owns the campaign",
      "campaigns[].assets[].brand_id = inherited from the parent campaign at creation time (immutable afterwards)",
      "scheduled-items[].scheduled[].brand_id = captured at schedule-time from the source asset",
      "publishing-references[].brand_id = captured at publish-time",
      "Hooks/memes/captions generated via /api/intel/generate_* scope to the selected brand's voice by default"
    ]
  }
