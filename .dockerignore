# Mirror of .railwayignore, minus anything the Dockerfile COPY's
# (scripts/, data/, assets/, campaign-os/requirements.txt, campaign-os/).
# Local `docker build` must see the same context Railway sees.

credentials/
clients/
agents/
memory/
shared/
docs/
.github/
node_modules/
media/
.git/
logs/
*.log
**/__pycache__/
*.pyc
.agent-job.json
.agent-job/
campaign-os/*.bak
campaign-os/build-board.html
campaign-os/cockpit.html
campaign-os/command-centre.html
campaign-os/release-plan.html
campaign-os/workspace-trackman.html
campaign-os/V2-*.md
campaign-os/README.md
campaign-os/app.js
campaign-os/server.js
campaign-os/start-bp-server.sh
campaign-os/campaign-data-staged.json
campaign-os/campaign-data.v1.backup.json
